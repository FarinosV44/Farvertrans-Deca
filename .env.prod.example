# Farvertrans DeCA — PRODUCTION env for docker-compose.prod.yml
# Copy to .env.prod (gitignored) and fill in real values. Never commit .env.prod.

# --- Postgres (the bundled db service reads these) ---
POSTGRES_USER="fvd"
POSTGRES_PASSWORD="CHANGE-ME-long-random"
POSTGRES_DB="farvertrans_deca"

# --- App ---
# Must match the public HTTPS URL the site is served on (canonical links, sitemap,
# OG tags, and the DeCA public /d/[token] URL all use it — R-5/R-6).
NEXT_PUBLIC_FVD_BASE_URL="https://linen-mantis-554500.hostingersite.com"

# Prisma connection — points at the compose `db` service by name. The bundled
# Postgres has no pooler, so DIRECT_URL is the same value (Prisma still requires
# it — see prisma/schema.prisma).
DATABASE_URL="postgresql://fvd:CHANGE-ME-long-random@db:5432/farvertrans_deca?schema=public"
DIRECT_URL="postgresql://fvd:CHANGE-ME-long-random@db:5432/farvertrans_deca?schema=public"

# PDF storage: "local" writes to FVD_STORAGE_DIR (persisted by the fvd-prod-storage
# volume mounted at /app/.storage). Switch to "supabase" only if you provision a bucket.
FVD_STORAGE="local"
FVD_STORAGE_DIR="/app/.storage"
FVD_PDF_BUCKET="deca-pdfs"

# Secret for hashing IPs/fingerprints and signing the session cookie (≥ 16 chars, random).
FVD_HASH_SECRET="CHANGE-ME-to-a-long-random-string"

# Verbose logging — keep 0 in production.
FVD_DEBUG="0"

# Deploy-host only: skip ESLint + typecheck during `next build`. Both are enforced
# in CI on every push to main. Set on a slow/constrained host (Hostinger Cloud
# Startup). NEVER set in CI.
# SKIP_BUILD_CHECKS="1"

# --- Optional: only needed for claim links / driver email share ---
RESEND_API_KEY=""
FVD_MAIL_FROM="DeCA Farvertrans <deca@example.com>"

# --- Optional: only needed if abuse challenges escalate to captcha ---
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET_KEY=""

# --- Optional: Supabase (leave as-is unless FVD_STORAGE=supabase) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# --- Deploy verification (P0 FIX #29) ---
# Long random string. Enables `npm run diagnose -- https://your-domain` to read
# /api/admin/diagnostics from a runbook or CI step. Empty = header auth disabled.
FVD_ADMIN_TOKEN=""

# Farvertrans DeCA — environment (placeholders only, never commit real values)

# Public base URL used for canonical links, sitemap, OG tags and the DeCA public /d/[token] URL.
# Placeholder until the real domain is decided (D-011).
NEXT_PUBLIC_FVD_BASE_URL="http://localhost:3000"

# Supabase (D-013) — from the Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# Postgres connection strings for Prisma — TWO separate ones against Supabase,
# because its session pooler has a hard low `pool_size` (Supavisor free tier: 15)
# shared by the running app AND every migration/tooling connection.
# Local docker (npm run db:up): both = postgresql://postgres:postgres@localhost:5432/farvertrans_deca
#
# DATABASE_URL — runtime queries. Supabase: the TRANSACTION pooler, port 6543,
# with `pgbouncer=true` (it multiplexes many app connections over few Postgres
# backends, so it does not hit the session pooler's connection cap).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/farvertrans_deca?schema=public"

# DIRECT_URL — migrations only (`prisma migrate deploy`/`status`). Supabase: the
# SESSION pooler, port 5432 (DDL + advisory locks don't work reliably over a
# transaction-mode pooler). Same value as DATABASE_URL for local docker.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/farvertrans_deca?schema=public"

# Private Supabase Storage bucket that holds generated PDFs (never public).
FVD_PDF_BUCKET="deca-pdfs"

# PDF storage backend: "local" (dev/tests → .storage/) or "supabase" (production).
FVD_STORAGE="local"

# FVD_STORAGE=local only: absolute path to a directory that PERSISTS across deploys
# and lives OUTSIDE the build/deploy tree. The DeCA PDF store is the repository of
# record for ≥ 1 year (R-10), so on a managed host it must not be wiped on redeploy.
# Leave empty for dev/tests (uses ./.storage/). Example: /var/lib/farvertrans/deca
FVD_STORAGE_DIR=""

# Secret used to hash IPs / fingerprints in access logs and abuse counters (any long random string).
FVD_HASH_SECRET="change-me-to-a-long-random-string"

# Transactional email (Resend) — needed for claim links and driver email share.
RESEND_API_KEY="re_YOUR_KEY"
FVD_MAIL_FROM="DeCA Farvertrans <deca@example.com>"

# hCaptcha (abuse challenge) — only triggered above a soft threshold.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET_KEY=""

# Toggle verbose pino debug logging (never on in production images).
FVD_DEBUG="0"

# Internal diagnostics token (P0 FIX #29). Lets `npm run diagnose -- <url>` read
# /api/admin/diagnostics without an internal session. Leave empty to disable.
FVD_ADMIN_TOKEN=""

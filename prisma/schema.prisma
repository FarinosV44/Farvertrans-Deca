// Farvertrans DeCA — data model (docs/02-functional-spec.md §Data model).
// Supabase Auth owns auth.* ; this schema owns every application table.

generator client {
  provider      = "prisma-client-js"
  output        = "./generated/client"
  // Ship engines for the build host AND common Linux targets, so a client
  // generated on Windows still runs on a Linux server (and CI / Docker).
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through Supabase's transaction pooler (port 6543,
  // `pgbouncer=true`) — it multiplexes many app connections over few Postgres
  // backends. Migrations/introspection use `directUrl` (session pooler, port
  // 5432) instead: DDL + advisory locks don't work reliably over a
  // transaction-mode pooler. Splitting these avoids the session pooler's low
  // `pool_size` (Supavisor free tier: 15) being exhausted by the running app.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A Farvertrans operator / commercial / collaborator whose `ref_code` appears
/// in acquisition links (#86 part 8). Each operator gets an individual
/// `/registro?ref=<ref_code>` link; a company that registers through it is
/// attributed first-touch and permanently (`Acquisition.firstRefCode`, #11),
/// which is what future commission calculation will read. Deactivating an
/// operator (`active = false`) never removes its attribution history.
model Operator {
  id        String   @id @default(cuid())
  name      String
  lastName  String?  @map("last_name")
  email     String?
  phone     String?
  notes     String?
  refCode   String   @unique @map("ref_code")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("operator")
}

/// The account's own transport company.
model Company {
  id              String          @id @default(cuid())
  name            String
  nif             String?
  address         String?
  /// Postal code and town, kept as their own fields (#59) rather than buried
  /// in the free-text `address` line, so a complete, queryable ficha exists.
  postalCode      String?         @map("postal_code")
  city            String?
  contactName     String?         @map("contact_name")
  phone           String?
  /// Company contact email (distinct from any member's own login email) —
  /// editable on `/panel/empresa`, owner-only, for invoicing/support contact.
  email           String?
  /// Set the first time the ficha passes the full mandatory-data check (#59).
  /// Drives the soft gate for pre-#59 companies without re-validating on every
  /// request. Columns stay nullable — "mandatory" is enforced in the app.
  dataCompletedAt DateTime?       @map("data_completed_at")
  /// Account lifecycle (#62). A non-`active` company blocks every member's
  /// panel access; `/d/[token]` for its already-issued DeCA is never affected.
  status          AccountStatus   @default(active)
  statusReason    String?         @map("status_reason")
  statusChangedAt DateTime?       @map("status_changed_at")
  anonymizedAt    DateTime?       @map("anonymized_at")
  /// #103 — excluded from business KPIs and hidden from the default Superadmin
  /// list by default; never affects auth, panel access, or data integrity.
  /// Reversible, audited (`company_marked_test` / `company_unmarked_test`).
  isTest          Boolean         @default(false) @map("is_test")
  profile         CompanyProfile?
  /// Optional PDF header logo (PRODUCT #39), stored as a data URI (PNG/JPEG,
  /// size-capped — see lib/company/logo.ts). Read at DOCUMENT CREATION time
  /// only: changing or removing it never alters an already-rendered PDF,
  /// since every version's bytes are already stored and immutable.
  logoDataUri     String?         @map("logo_data_uri")
  createdAt       DateTime        @default(now()) @map("created_at")

  users                 User[]
  memberships           Membership[]
  decas                 Deca[]
  acquisition           Acquisition?
  invites               CompanyInvite[]
  commercialConsent     CommercialConsent?
  commercialEvents      CommercialConsentEvent[]
  availabilityShares    DecaAvailabilityShare[]
  savedCompanies        SavedCompany[]
  savedVehicles         SavedVehicle[]
  savedLocations        SavedLocation[]
  savedShipments        SavedShipment[]
  decaDrafts            DecaDraft[]
  favoriteRoutes        FavoriteRoute[]
  integrationRequests   IntegrationRequest[]
  supportTickets        SupportTicket[]
  commercialOpportunity CommercialOpportunity?
  commercialActivityLog CommercialActivityLog[]
  commercialAlerts      CommercialAlert[]

  @@map("company")
}

/// Company's primary use-case (TRUST #42 / GROWTH #46 signup profile picker) —
/// for onboarding/personalisation only, never gates functionality.
enum CompanyProfile {
  carrier_goods
  shipper
  operator
  carrier_passengers
}

/// Company-level commercial-treatment preference (#84, evolving DATA #45 §3).
/// Separate from `TermsAcceptance` — opt-in, granular, revocable, never assumed
/// from ordinary product use, and never a condition of the free service. One
/// row per company; the full history of changes lives in `CommercialConsentEvent`.
model CommercialConsent {
  id           String                    @id @default(cuid())
  companyId    String                    @unique @map("company_id")
  mode         CommercialConsentMode     @default(none)
  channel      CommercialContactChannel?
  /// The exact contact values the operator authorised for the selected channel
  /// — stored here, not read live from the company ficha, so a later ficha edit
  /// never silently changes what has been consented to.
  contactEmail String?                   @map("contact_email")
  contactPhone String?                   @map("contact_phone")
  /// The legal-text version in force when the current preference was set.
  version      String
  grantedAt    DateTime?                 @map("granted_at")
  revokedAt    DateTime?                 @map("revoked_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("commercial_consent")
}

/// Append-only audit of every commercial-treatment change and every prepared or
/// withdrawn availability record (#84). Structured detail lives here because
/// `SecurityAuditLog` has no metadata column. No more DeCA content is recorded
/// than is needed to evidence the authorisation.
model CommercialConsentEvent {
  id           String                    @id @default(cuid())
  companyId    String                    @map("company_id")
  actorUserId  String?                   @map("actor_user_id")
  /// mode_set | channel_set | per_deca_enabled | per_deca_disabled |
  /// global_revoked | availability_prepared | availability_withdrawn |
  /// availability_updated
  kind         String
  decaId       String?                   @map("deca_id")
  mode         CommercialConsentMode?
  channel      CommercialContactChannel?
  legalVersion String                    @map("legal_version")
  /// The authorised-field snapshot for an availability record (never origin,
  /// cargador, goods, plates, price, QR, URL or document content).
  detail       Json?
  createdAt    DateTime                  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("commercial_consent_event")
}

/// The "ficha de disponibilidad comercial" prepared for a single DeCA when the
/// operator has authorised sharing for that porte (#84, expanded #119). Holds
/// ONLY the fields the operator explicitly authorised — the table has no
/// column for origin, cargador identity, load address, goods, weight, price,
/// plates, driver, token or public URL, so those data can never be shared
/// through this path. Nothing is transmitted to any third party yet (no
/// recipient side exists); a row sits at `pending` until withdrawn.
///
/// #119 — `destination` stays the "zona de disponibilidad" (renamed only in
/// the UI, not the column, to avoid a risky rename); `preferredDestination`,
/// `capacityMode`/`linearMeters`/`maxWeightKg`, and `vehicleType` are all NEW,
/// additive, nullable columns — every field the operator explicitly
/// volunteers to receive compatible offers, never derived from DeCA content.
/// `finalShipmentIndex` records which shipment's unload seeded the zona/fecha
/// defaults for a multi-envío DeCA — purely a UI convenience at creation
/// time, never altering the DeCA's own shipment numbering or legal order.
/// "Expired" is deliberately NOT a stored status — it is computed at read
/// time from `availabilityDate` (see `expiryStatus()` in
/// `lib/commercial/availability.ts`), so no scheduled job was invented for a
/// requirement this issue doesn't ask for.
model DecaAvailabilityShare {
  id                   String                   @id @default(cuid())
  decaId               String                   @unique @map("deca_id")
  companyId            String                   @map("company_id")
  carrierName          String                   @map("carrier_name")
  destination          String
  availabilityDate     DateTime                 @map("availability_date")
  channel              CommercialContactChannel
  contactEmail         String?                  @map("contact_email")
  contactPhone         String?                  @map("contact_phone")
  legalVersion         String                   @map("legal_version")
  /// pending | withdrawn
  status               String                   @default("pending")
  preparedAt           DateTime                 @default(now()) @map("prepared_at")
  withdrawnAt          DateTime?                @map("withdrawn_at")
  /// #119 — voluntary next-load preference, independent of the DeCA's cargo.
  preferredDestination String?                  @map("preferred_destination")
  /// #119 — "full" | "partial". Bare string (not an enum), matching `status`'s
  /// own convention, so a future value never needs a migration.
  capacityMode         String                   @default("full") @map("capacity_mode")
  /// #119 — required together with maxWeightKg when capacityMode = "partial";
  /// both null when "full" (never a stale value left over from a mode switch).
  linearMeters         Float?                   @map("linear_meters")
  maxWeightKg          Int?                     @map("max_weight_kg")
  /// #119 — "lona" | "frigorifico" | null (unspecified). Bare string, same
  /// extensibility reasoning as capacityMode.
  vehicleType          String?                  @map("vehicle_type")
  /// #119 — which shipment (0-based) of a multi-envío DeCA supplied the zona/
  /// fecha defaults; null for a single-shipment DeCA (shipment 0, implicitly).
  finalShipmentIndex   Int?                     @map("final_shipment_index")

  deca    Deca    @relation(fields: [decaId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("deca_availability_share")
}

/// The commercial follow-up state for one carrier company, set by the internal
/// team from the `Super Admin > Oportunidades` radar (#87). It is a workflow
/// note, never a legal or billing state, and it is completely independent of
/// the company's own `CommercialConsent` — losing every row here changes
/// nothing about what a company has authorised. One row per company; absence
/// means "not reviewed yet".
model CommercialOpportunity {
  id                String                     @id @default(cuid())
  companyId         String                     @unique @map("company_id")
  state             CommercialOpportunityState @default(review)
  /// Free internal note (last contact, who to call, why discarded…). No PII rules
  /// beyond the app-wide ones — this is an internal CRM-lite field.
  note              String?
  /// The internal user who last changed the state, for the activity trail.
  updatedByUserId   String?                    @map("updated_by_user_id")
  contactedAt       DateTime?                  @map("contacted_at")
  /// #89 — the internal COMMERCIAL operator who converted the opportunity, kept
  /// distinct from the acquisition/referral operator (`Acquisition.firstRefCode`,
  /// #2/#86): one measures acquisition, the other measures commercial
  /// exploitation.
  convertedByUserId String?                    @map("converted_by_user_id")
  convertedAt       DateTime?                  @map("converted_at")
  /// #89 — optional, manual economic outcome once the carrier does real work for
  /// Farvertrans. No ERP/TMS integration; rough figures entered by hand. Money in
  /// whole euros.
  internalRef       String?                    @map("internal_ref")
  firstPorteDate    DateTime?                  @map("first_porte_date")
  loadsGenerated    Int?                       @map("loads_generated")
  revenueEur        Int?                       @map("revenue_eur")
  marginEur         Int?                       @map("margin_eur")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([state])
  @@map("commercial_opportunity")
}

/// Internal commercial follow-up state for a carrier (#87 / #89). `review` =
/// surfaced by the radar, not yet acted on. The rest track a manual outreach and
/// first-load lifecycle, ending in `converted` (now a Farvertrans carrier) or
/// `discarded`.
enum CommercialOpportunityState {
  review
  contacted
  interested
  not_interested
  unavailable
  awaiting_load
  first_load_offered
  first_load_awarded
  converted
  discarded
}

/// #89 — append-only trail of every commercial action on an opportunity: who,
/// when, the state change, the channel used, an optional short note, and the
/// route/corridor that originated the contact when known. Never stores WhatsApp
/// conversation content — only what an operator types as an internal note.
model CommercialActivityLog {
  id           String                      @id @default(cuid())
  companyId    String                      @map("company_id")
  actorUserId  String?                     @map("actor_user_id")
  fromState    CommercialOpportunityState? @map("from_state")
  toState      CommercialOpportunityState? @map("to_state")
  /// whatsapp | email | call | other | none
  channel      String                      @default("none")
  note         String?
  /// e.g. a corridor id or "Valencia → Lyon" — the opportunity/route context.
  routeContext String?                     @map("route_context")
  createdAt    DateTime                    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("commercial_activity_log")
}

/// #90 — an internal, rule-based alert surfaced in Super Admin. Computed from
/// the account's own data (activity, recurrence, route, follow-up state); never
/// sent anywhere. Only ever created for a company eligible for commercial use
/// (`CommercialConsent.mode != none`). `dedupeKey` keeps one live alert per
/// company + kind + time bucket so the centre never floods.
model CommercialAlert {
  id               String   @id @default(cuid())
  companyId        String   @map("company_id")
  /// Rule id, e.g. `upcoming_priority_zone`, `route_repeated_3x_30d`,
  /// `interested_no_followup`, `reactivated_after_60d`.
  kind             String
  dedupeKey        String   @unique @map("dedupe_key")
  title            String
  detail           String
  /// Higher = more worth reviewing. Used for ordering.
  score            Int      @default(0)
  routeContext     String?  @map("route_context")
  /// pending | reviewed | dismissed
  status           String   @default("pending")
  reviewedByUserId String?  @map("reviewed_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, score])
  @@index([companyId])
  @@map("commercial_alert")
}

/// #90 — the small, single-row config for the alert rules. No visual builder:
/// priority corridors/countries, minimum movements, the activity window, and
/// the follow-up/reactivation day thresholds.
model CommercialAlertConfig {
  id                String   @id @default("singleton")
  priorityCorridors String[] @default([]) @map("priority_corridors")
  priorityCountries String[] @default([]) @map("priority_countries")
  minMovements      Int      @default(2) @map("min_movements")
  windowDays        Int      @default(30) @map("window_days")
  staleFollowUpDays Int      @default(10) @map("stale_follow_up_days")
  reactivationDays  Int      @default(60) @map("reactivation_days")
  updatedByUserId   String?  @map("updated_by_user_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("commercial_alert_config")
}

/// A registered user, linked 1:1 to a Supabase auth user by authUserId.
model User {
  id              String        @id @default(cuid())
  authUserId      String        @unique @map("auth_user_id")
  /// D-203: unique at the DB level, not just app-checked (`signup()`'s
  /// findFirst was a TOCTOU race — two near-simultaneous requests for the
  /// same email could both pass the check and each create a user + company).
  /// Always normalized (trim+lowercase, `normEmail()`) before it reaches here.
  email           String        @unique
  passwordHash    String?       @map("password_hash")
  googleId        String?       @unique @map("google_id")
  companyId       String?       @map("company_id")
  role            Role          @default(user)
  companyRole     CompanyRole   @default(owner) @map("company_role")
  emailVerifiedAt DateTime?     @map("email_verified_at")
  /// I18N: "es" or "en" (lib/i18n/locale.ts). Restored into the `fvd_locale`
  /// cookie on login so the UI comes back in the language they left it in.
  preferredLocale String        @default("es") @map("preferred_locale")
  /// #93: up to 3 quick accesses on Inicio, chosen by THIS user from the fixed
  /// catalogue in `lib/panel/quick-actions.ts`. Per-user, never per-company —
  /// one operator reordering their own Inicio must not touch a colleague's.
  /// Empty = never configured, so `resolveQuickActions()` serves the defaults.
  quickActions    String[]      @default([]) @map("quick_actions")
  /// SECURITY #53: bumped on password change/reset and "log out everywhere".
  /// A session token embeds the version it was issued at; `getCurrentUser()`
  /// rejects a token whose version doesn't match this column, since sessions
  /// are stateless (signed, not stored) and have no other revocation path.
  sessionVersion  Int           @default(1) @map("session_version")
  /// SECURITY #53: mandatory admin 2FA. Base32 TOTP secret, set at enrollment
  /// and never logged/returned once `totpEnabledAt` is set. Null = not
  /// enrolled — `requireInternal()` forces enrollment before any admin access.
  totpSecret      String?       @map("totp_secret")
  totpEnabledAt   DateTime?     @map("totp_enabled_at")
  /// Account lifecycle (#62). A non-`active` user is logged out everywhere on
  /// the next request (same effect as a `sessionVersion` bump) and cannot log
  /// back in until reactivated.
  status          AccountStatus @default(active)
  statusReason    String?       @map("status_reason")
  statusChangedAt DateTime?     @map("status_changed_at")
  anonymizedAt    DateTime?     @map("anonymized_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  /// #102: this is the ACTIVE company/role only — a denormalized "current
  /// view" kept in sync by every mutation in `lib/team.ts`, read by every
  /// company-scoped query in the app exactly as before. The SOURCE OF TRUTH
  /// for "does this user belong to this company" is `Membership`, never this
  /// column: accepting a second invite must never overwrite it away from a
  /// membership that still exists, and removing one membership must fall
  /// back to another the user still holds rather than nulling the account
  /// into "no company" the way the pre-#102 bug did.
  company             Company?             @relation(fields: [companyId], references: [id])
  memberships         Membership[]
  createdDecas        Deca[]               @relation("DecaCreatedBy")
  acquisition         Acquisition?
  savedCompanies      SavedCompany[]
  savedVehicles       SavedVehicle[]
  savedLocations      SavedLocation[]
  savedShipments      SavedShipment[]
  recoveryCodes       AdminRecoveryCode[]
  webauthnCredentials WebAuthnCredential[]
  trustedDevices      TrustedDevice[]
  decaDraft           DecaDraft?
  supportTickets      SupportTicket[]
  historyViews        SavedHistoryView[]

  @@map("user")
}

/// #92 — a named combination of the filters `/panel/historico` ALREADY has,
/// private to one user. Per-user rather than per-company on purpose: a saved
/// view is a personal shortcut, and one operator's views must never reorder a
/// colleague's screen (the issue is explicit about this).
///
/// The columns are exactly `HISTORY_FILTER_KEYS` in `lib/data/history-views.ts`;
/// #92 introduces no new filter, so this table must never grow one that the
/// Histórico form does not already submit.
model SavedHistoryView {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  q         String?
  from      String?
  to        String?
  carrier   String?
  plate     String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Renaming onto an existing name is rejected rather than creating a second
  /// chip the user cannot tell apart.
  @@unique([userId, name])
  @@index([userId])
  @@map("saved_history_view")
}

/// Internal technical-support ticket (#86 part 5). A message sent from the
/// panel's "Asistencia técnica" becomes a tracked ticket visible to the
/// superadmin — never just an email. LEGAL queries are NOT tickets (#86 part 6):
/// they go straight to the Praetoria legal channel.
enum SupportTicketStatus {
  new
  in_review
  awaiting_user
  resolved
  closed
}

model SupportTicket {
  id          String              @id @default(cuid())
  /// Human-facing sequential number ("Incidencia #123").
  number      Int                 @unique @default(autoincrement())
  companyId   String?             @map("company_id")
  userId      String?             @map("user_id")
  /// Captured at creation so the ticket stays complete if the user/company is later removed.
  userEmail   String              @map("user_email")
  userName    String?             @map("user_name")
  companyName String?             @map("company_name")
  category    String
  subject     String
  status      SupportTicketStatus @default(new)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  company  Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user     User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages SupportTicketMessage[]

  @@index([status])
  @@index([companyId])
  @@index([createdAt])
  @@map("support_ticket")
}

model SupportTicketMessage {
  id         String   @id @default(cuid())
  ticketId   String   @map("ticket_id")
  /// "user" or "admin".
  authorType String   @map("author_type")
  authorId   String?  @map("author_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_message")
}

/// A single in-progress DeCA the user has not generated yet (#76). One per
/// user (`userId @unique`); the wizard upserts it as they type. It carries NO
/// token, PDF, QR or public URL — it becomes a real `Deca` only on generation,
/// at which point the draft is deleted. Never shown alongside issued documents.
model DecaDraft {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  companyId String   @map("company_id")
  /// The flat wizard form state (partial, unvalidated). Size-capped by the API.
  dataJson  Json     @map("data_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("deca_draft")
}

/// SECURITY #53 passkey follow-up: a registered WebAuthn credential (Face
/// ID/Touch ID/Windows Hello/security key), the primary admin 2FA method.
/// TOTP (above) stays as the fallback — either method satisfies
/// `requireInternal()`'s "fresh 2FA check" requirement identically, via the
/// same `tv` session timestamp. Only the public key is ever stored; the
/// private key never leaves the authenticator.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  /// Base64url credential ID from the authenticator — how a login/step-up
  /// challenge finds which public key to verify against.
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  /// Signature counter — WebAuthn replay protection (must strictly increase
  /// on every use; a non-increasing counter means a cloned authenticator).
  counter      BigInt    @default(0)
  /// "singleDevice" | "multiDevice" (a synced passkey, e.g. iCloud Keychain).
  deviceType   String    @map("device_type")
  backedUp     Boolean   @default(false) @map("backed_up")
  /// Comma-separated AuthenticatorTransport hints ("internal,hybrid", …).
  transports   String?
  /// User-facing label ("iPhone de Ana") — set from the device/browser at
  /// registration time, editable nowhere yet (not required by the brief).
  name         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credential")
}

/// SECURITY #53 passkey follow-up: "trust this device" for ~30 days after a
/// successful strong-auth check, so an admin isn't re-challenged on every
/// visit from their own phone/laptop. Same hashed-token-in-DB shape as
/// `PasswordResetToken`/`EmailVerificationToken`, except a trusted device is
/// reusable until expiry/revocation rather than single-use, hence
/// `revokedAt` instead of `usedAt`. Revoked wholesale on password change/
/// reset and "log out everywhere" (`bumpSessionVersion`) — a compromised
/// password must never leave a standing bypass of 2FA behind.
model TrustedDevice {
  tokenHash  String    @id @map("token_hash")
  userId     String    @map("user_id")
  label      String?
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_device")
}

/// SECURITY #53: one-time admin 2FA recovery codes, shown once at enrollment
/// (or regeneration, which requires step-up re-auth). Only the hash is
/// stored; a code is marked used, never deleted, so a stolen/replayed code
/// is always rejected rather than silently accepted a second time.
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_recovery_code")
}

/// SECURITY #53: append-only audit trail for sensitive admin/security events.
/// No update/delete path is exposed anywhere in the product — only inserts
/// and reads. `actorId` is a plain string (not a relation) so a row survives
/// even if the actor account is later deleted.
model SecurityAuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  result     String
  ip         String?
  userAgent  String?  @map("user_agent")
  /// #102/#103 — free-text context for actions whose audit value depends on
  /// WHY, not just what/who/when (a Superadmin membership reassignment's
  /// stated reason, a company marked TEST). Never a place for secrets or
  /// personal data beyond what the action itself already concerns.
  detail     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("security_audit_log")
}

enum Role {
  user
  internal
}

/// Role WITHIN a company workspace (TEAM #27, PRODUCT #56). `owner` = Company
/// Admin, `member` = Operator (creates/manages DeCA and saved data, no team/
/// billing/security management), `read_only` = Auditor (can view history and
/// documents but cannot create, correct, or modify anything — enforced
/// server-side on every mutating route, never just hidden in the UI).
enum CompanyRole {
  owner
  member
  read_only
}

/// Account lifecycle state for a `User` or a `Company` (#62). `active` =
/// normal. `blocked` = access suspended, data and documents kept, all live
/// sessions invalidated. `deactivated` = a stable "given up" state, also no
/// access, reversible. `anonymized` = PII overwritten in place — the row and
/// every DeCA / audit record are kept (D-067), the operation is not reversible.
enum AccountStatus {
  active
  blocked
  deactivated
  anonymized
}

/// Granular commercial-treatment preference (#84). `none` = never communicate
/// any availability data. `per_deca` = ask on each DeCA (control off by
/// default). `all` = communicate for every future DeCA unless the operator
/// disables it on that specific porte. Free use of the product is never
/// conditioned on this — `none` is the normal, neutral default.
enum CommercialConsentMode {
  none
  per_deca
  all
}

/// Which contact channel the operator has authorised for a commercial
/// availability offer (#84). Only the value(s) selected here are ever shared.
enum CommercialContactChannel {
  email
  phone
  both
}

/// A pending invitation to join a company workspace (TEAM #27). One-time, expiring.
model CompanyInvite {
  id              String      @id @default(cuid())
  companyId       String      @map("company_id")
  email           String
  tokenHash       String      @unique @map("token_hash")
  role            CompanyRole @default(member)
  invitedByUserId String      @map("invited_by_user_id")
  expiresAt       DateTime    @map("expires_at")
  acceptedAt      DateTime?   @map("accepted_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
  @@map("company_invite")
}

/// #102 — the SOURCE OF TRUTH for "does this user belong to this company",
/// separate from `User.companyId`/`companyRole` (which stay a denormalized
/// "currently active" view, never the record of membership itself). A user
/// may hold more than one; the pre-#102 bug existed because there was no
/// table like this one — accepting a second invite could only overwrite the
/// single `User.companyId` FK, and removing a member had nothing to delete
/// except that same FK, so "leave company B" and "lose company A" were the
/// same operation. Every mutation goes through `lib/team.ts` — never a raw
/// `prisma.user.update({ companyId })` anywhere else in the app.
model Membership {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  companyId String      @map("company_id")
  role      CompanyRole @default(member)
  createdAt DateTime    @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("membership")
}

/// First-touch / last-touch acquisition attribution, one row per user or company.
model Acquisition {
  id               String    @id @default(cuid())
  userId           String?   @unique @map("user_id")
  companyId        String?   @unique @map("company_id")
  firstRefCode     String?   @map("first_ref_code")
  lastRefCode      String?   @map("last_ref_code")
  firstLandingUrl  String?   @map("first_landing_url")
  firstUtmSource   String?   @map("first_utm_source")
  firstUtmMedium   String?   @map("first_utm_medium")
  firstUtmCampaign String?   @map("first_utm_campaign")
  firstUtmContent  String?   @map("first_utm_content")
  firstUtmTerm     String?   @map("first_utm_term")
  lastUtmSource    String?   @map("last_utm_source")
  lastUtmMedium    String?   @map("last_utm_medium")
  lastUtmCampaign  String?   @map("last_utm_campaign")
  lastUtmContent   String?   @map("last_utm_content")
  lastUtmTerm      String?   @map("last_utm_term")
  firstSeenAt      DateTime? @map("first_seen_at")
  signupAt         DateTime? @map("signup_at")
  firstDecaAt      DateTime? @map("first_deca_at")

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@map("acquisition")
}

/// A DeCA document. The current legally-valid version is currentVersionId.
model Deca {
  id               String    @id @default(cuid())
  companyId        String?   @map("company_id")
  createdByUserId  String?   @map("created_by_user_id")
  currentVersionId String?   @unique @map("current_version_id")
  idempotencyKey   String?   @unique @map("idempotency_key")
  serviceStart     DateTime? @map("service_start")
  serviceEnd       DateTime? @map("service_end")
  /// Lightweight identity captured before an anonymous first DeCA (TRUST #42 §3).
  /// Never required once the document has an owning company/user.
  creatorName      String?   @map("creator_name")
  creatorEmail     String?   @map("creator_email")
  createdAt        DateTime  @default(now()) @map("created_at")

  company           Company?               @relation(fields: [companyId], references: [id])
  createdByUser     User?                  @relation("DecaCreatedBy", fields: [createdByUserId], references: [id])
  currentVersion    DecaVersion?           @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions          DecaVersion[]          @relation("DecaVersions")
  claimTokens       ClaimToken[]
  routeIntel        DecaRouteIntel[]
  availabilityShare DecaAvailabilityShare?

  @@map("deca")
}

/// An append-only version of a DeCA. Never updated after creation (except pdfPath on first write).
model DecaVersion {
  id              String   @id @default(cuid())
  decaId          String   @map("deca_id")
  versionNo       Int      @map("version_no")
  token           String   @unique
  pdfPath         String?  @map("pdf_path")
  pdfSha256       String?  @map("pdf_sha256")
  dataJson        Json     @map("data_json")
  changeReason    String?  @map("change_reason")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  deca       Deca            @relation("DecaVersions", fields: [decaId], references: [id], onDelete: Cascade)
  currentOf  Deca?           @relation("CurrentVersion")
  accessLog  DecaAccessLog[]
  routeIntel DecaRouteIntel?

  @@unique([decaId, versionNo])
  @@index([decaId])
  @@map("deca_version")
}

/// Normalized/queryable route data derived from a goods DeCA version (DATA #45).
/// Kept strictly separate from `DecaVersion.dataJson` — the immutable legal
/// snapshot used to render the PDF is never rewritten; this row is disposable,
/// best-effort, derived intelligence that can be recomputed from it at any time.
/// One row per version (a correction that changes the route gets its own row).
model DecaRouteIntel {
  id                String    @id @default(cuid())
  decaId            String    @map("deca_id")
  decaVersionId     String    @unique @map("deca_version_id")
  companyId         String?   @map("company_id")
  transportType     String    @default("goods") @map("transport_type")
  carrierName       String?   @map("carrier_name")
  loadCompanyName   String?   @map("load_company_name")
  loadCity          String?   @map("load_city")
  loadProvince      String?   @map("load_province")
  loadCountry       String?   @map("load_country")
  loadPostalCode    String?   @map("load_postal_code")
  unloadCompanyName String?   @map("unload_company_name")
  unloadCity        String?   @map("unload_city")
  unloadProvince    String?   @map("unload_province")
  unloadCountry     String?   @map("unload_country")
  unloadPostalCode  String?   @map("unload_postal_code")
  loadDate          DateTime? @map("load_date")
  unloadDate        DateTime? @map("unload_date")
  tractorPlate      String?   @map("tractor_plate")
  trailerPlate      String?   @map("trailer_plate")
  /// Normalized corridor key, e.g. "ES-VALENCIA__FR-LYON" — city+country only,
  /// diacritics/case-folded, for cheap recurrence grouping before real geocoding.
  routeKey          String?   @map("route_key")
  generatedAt       DateTime  @default(now()) @map("generated_at")

  deca    Deca        @relation(fields: [decaId], references: [id], onDelete: Cascade)
  version DecaVersion @relation(fields: [decaVersionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([loadCountry, loadProvince, loadCity])
  @@index([unloadCountry, unloadProvince, unloadCity])
  @@index([routeKey])
  @@map("deca_route_intel")
}

/// One-time token to attach an anonymous DeCA to an account (30-day TTL, D-016).
model ClaimToken {
  token     String    @id
  decaId    String    @map("deca_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  deca Deca @relation(fields: [decaId], references: [id], onDelete: Cascade)

  @@index([decaId])
  @@map("claim_token")
}

/// A saved party's role in a transport (WORKSPACE #24) — "both" fills either
/// slot in "usar el mismo" when the contractual shipper and effective carrier
/// are the same legal entity.
enum SavedPartyRole {
  shipper
  carrier
  both
}

/// Reusable cargador contractual / transportista efectivo (WORKSPACE #24).
/// Scoped to the COMPANY (a shared team resource, TEAM #27) — `userId` is
/// kept only as the creator, for audit. Editing/deleting never touches an
/// already-generated DeCA — every document holds its own copy of the data.
model SavedCompany {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  companyId    String         @map("company_id")
  name         String
  nif          String?
  address      String?
  postalCode   String?        @map("postal_code")
  city         String?
  contactName  String?        @map("contact_name")
  contactPhone String?        @map("contact_phone")
  contactEmail String?        @map("contact_email")
  role         SavedPartyRole @default(both)
  favorite     Boolean        @default(false)
  lastUsedAt   DateTime?      @map("last_used_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("saved_company")
}

/// Reusable tractor + trailer plate (WORKSPACE #24). Company-scoped like `SavedCompany`.
model SavedVehicle {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  companyId    String    @map("company_id")
  tractorPlate String    @map("tractor_plate")
  trailerPlate String?   @map("trailer_plate")
  alias        String?
  favorite     Boolean   @default(false)
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("saved_vehicle")
}

/// A loading/unloading point can serve — "both" fills either slot.
enum SavedLocationType {
  load
  unload
  both
}

/// Reusable lugar de carga/descarga (WORKSPACE #24) — replaces the old flat
/// `SavedAddress`; mirrors the DeCA's own structured location fields
/// (D-042) so it drops straight into the wizard with no reformatting.
model SavedLocation {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  companyId  String            @map("company_id")
  name       String
  address    String
  postalCode String?           @map("postal_code")
  city       String?
  province   String?
  country    String            @default("España")
  type       SavedLocationType @default(both)
  favorite   Boolean           @default(false)
  lastUsedAt DateTime?         @map("last_used_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  shipmentsAsLoad   SavedShipment[] @relation("SavedShipmentLoad")
  shipmentsAsUnload SavedShipment[] @relation("SavedShipmentUnload")

  @@index([companyId])
  @@map("saved_location")
}

/// A reusable single leg — place + place (+ optional goods/weight/recipient) —
/// for #113. Always references two existing `SavedLocation` rows; never
/// duplicates address text (issue §12). Deleting a `SavedLocation` still in
/// use by a route is RESTRICTED — a silent cascade would quietly destroy a
/// saved route the user is relying on, so the API surfaces a clear error
/// instead. Editing/deleting a route never touches an already-generated DeCA.
model SavedShipment {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  companyId        String    @map("company_id")
  name             String?
  loadLocationId   String    @map("load_location_id")
  unloadLocationId String    @map("unload_location_id")
  goods            String?
  weight           String?
  recipient        String?
  favorite         Boolean   @default(false)
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  loadLocation   SavedLocation @relation("SavedShipmentLoad", fields: [loadLocationId], references: [id], onDelete: Restrict)
  unloadLocation SavedLocation @relation("SavedShipmentUnload", fields: [unloadLocationId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("saved_shipment")
}

/// First-party analytics event. Never carries PII.
model Event {
  id          String   @id @default(cuid())
  name        String
  ts          DateTime @default(now())
  sessionId   String   @map("session_id")
  path        String
  refSnapshot Json?    @map("ref_snapshot")
  appVersion  String?  @map("app_version")

  @@index([name, ts])
  @@map("event")
}

/// Minimal public-download audit trail (R-11). Stores only a hashed IP.
model DecaAccessLog {
  id            String   @id @default(cuid())
  decaVersionId String   @map("deca_version_id")
  ipHash        String   @map("ip_hash")
  ts            DateTime @default(now())

  decaVersion DecaVersion @relation(fields: [decaVersionId], references: [id], onDelete: Cascade)

  @@index([decaVersionId])
  @@map("deca_access_log")
}

/// Company acquisition funnel (GROWTH #28) — a prospect Farvertrans is onboarding,
/// separate from the authenticated workspace until it activates.
model Prospect {
  id              String         @id @default(cuid())
  name            String
  nif             String?
  contactName     String?        @map("contact_name")
  email           String?
  phone           String?
  refCode         String         @map("ref_code") // assigned Farvertrans operator
  source          String? // campaign / channel note
  status          ProspectStatus @default(prospect)
  companyId       String?        @unique @map("company_id") // set once registered
  inviteTokenHash String?        @unique @map("invite_token_hash")
  inviteExpiresAt DateTime?      @map("invite_expires_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  invitedAt       DateTime?      @map("invited_at")
  registeredAt    DateTime?      @map("registered_at")
  firstDecaAt     DateTime?      @map("first_deca_at")
  lastDecaAt      DateTime?      @map("last_deca_at")

  @@index([refCode])
  @@index([status])
  @@map("prospect")
}

enum ProspectStatus {
  prospect
  invited
  registered
  activated
  active
}

/// A reusable DeCA template — recurring non-date data for a lane (UX #25).
model DecaTemplate {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  name      String
  dataJson  Json     @map("data_json")
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("deca_template")
}

/// A route (load city+country → unload city+country) a company pinned as a
/// favourite (#78). Not a stored DeCA — just a preference that floats a lane
/// to the top of the "rutas frecuentes" widget and the wizard. `routeKey`
/// matches `DecaRouteIntel.routeKey` (lib/deca/route-intel.ts).
model FavoriteRoute {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  routeKey      String   @map("route_key")
  loadCity      String   @map("load_city")
  loadCountry   String   @map("load_country")
  unloadCity    String   @map("unload_city")
  unloadCountry String   @map("unload_country")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, routeKey])
  @@map("favorite_route")
}

/// A company's request to connect a TMS/ERP (#74). Measures demand before any
/// public API is built — no keys are issued here. `need` is a short slug or
/// free text; `status` is an internal triage state.
model IntegrationRequest {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  userId       String?  @map("user_id")
  system       String
  need         String
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  volumeNote   String?  @map("volume_note")
  status       String   @default("new")
  createdAt    DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("integration_request")
}

/// One-time password-reset token (ACCOUNT #23). Short TTL, single use.
model PasswordResetToken {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_token")
}

/// Email verification token (GROWTH #46). Longer TTL than a password reset —
/// this is a courtesy confirmation, not a security-critical action.
model EmailVerificationToken {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id")
  email     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_token")
}

/// Versioned, auditable Terms & Conditions / Privacy acceptance (TRUST #42 §5).
/// Append-only — never updated after creation.
model TermsAcceptance {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  companyId  String?  @map("company_id")
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at")

  @@index([userId])
  @@map("terms_acceptance")
}

/// Sliding-window abuse counter keyed on hashed IP/fingerprint + window.
model AbuseCounter {
  keyHash     String   @map("key_hash")
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@id([keyHash, windowStart])
  @@map("abuse_counter")
}

/// A classified DeCA generation failure (P0 FIX #29) — the diagnosis surface behind
/// `/admin/errores` (#33). Holds NO DeCA payload and no personal data: only the
/// stage, a redacted error summary and runtime metadata, keyed by the short
/// correlation code the user is shown.
model GenerationFailure {
  id            String    @id @default(cuid())
  correlationId String    @unique @map("correlation_id")
  stage         String
  errorClass    String    @map("error_class")
  message       String
  route         String?
  authenticated Boolean   @default(false)
  companyId     String?   @map("company_id")
  appVersion    String?   @map("app_version")
  storageDriver String?   @map("storage_driver")
  retriedOk     Boolean   @default(false) @map("retried_ok")
  resolvedAt    DateTime? @map("resolved_at")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([stage, createdAt])
  @@index([createdAt])
  @@map("generation_failure")
}

/// Editorial content managed from the admin CMS (SEO #32) — guides and blog
/// posts rendered at /guias/[slug] and /blog/[slug]. Separate from the core
/// SEO cluster (content/seo/pages.ts), which stays at root slugs.
model ContentItem {
  id                String        @id @default(cuid())
  type              ContentType
  slug              String        @unique
  status            ContentStatus @default(draft)
  title             String
  excerpt           String
  body              String // markdown
  category          String?
  tags              String[]      @default([])
  heroImage         String?       @map("hero_image")
  authorName        String?       @map("author_name")
  // Optional named legal reviewer credit (e.g. a PRAETORIA lawyer), shown
  // as `reviewedBy` in Article JSON-LD and as a visible credit line.
  // Never auto-filled — only set explicitly, per-article, on real review.
  legalReviewerName String?       @map("legal_reviewer_name")
  focusKeyword      String?       @map("focus_keyword")
  seoTitle          String?       @map("seo_title")
  metaDescription   String?       @map("meta_description")
  canonicalOverride String?       @map("canonical_override")
  ogTitle           String?       @map("og_title")
  ogDescription     String?       @map("og_description")
  ogImage           String?       @map("og_image")
  robotsIndex       Boolean       @default(true) @map("robots_index")
  sources           Json          @default("[]") // {label,url}[]
  relatedSlugs      String[]      @default([]) @map("related_slugs")
  previousSlugs     String[]      @default([]) @map("previous_slugs")
  ctaLabel          String?       @map("cta_label")
  publishedAt       DateTime?     @map("published_at")
  lastReviewedAt    DateTime?     @map("last_reviewed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([type, status, publishedAt])
  @@index([status])
  @@map("content_item")
}

enum ContentType {
  guide
  blog
}

enum ContentStatus {
  draft
  published
  archived
}
